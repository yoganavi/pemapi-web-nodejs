      <p class="text-slate-600 text-lg">Dari konsultasi awal hingga maintenance jangka panjang — proses yang jelas dan terdokumentasi.</p>
    </div>
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-3">
      <% const steps = [
        { n: '01', t: 'Konsultasi', d: 'Diskusi kebutuhan Anda' },
        { n: '02', t: 'Pilih APAR', d: 'Rekomendasi sesuai risiko' },
        { n: '03', t: 'Instalasi', d: 'Penempatan strategis' },
        { n: '04', t: 'Registrasi Digital', d: 'QR Code per unit' },
        { n: '05', t: 'Inspeksi Rutin', d: 'Via PEMAPI App' },
        { n: '06', t: 'Maintenance', d: 'Refill terjadwal' }
      ]; %>
      <% steps.forEach(function(s) { %>
      <div class="bg-slate-50 rounded-xl p-4 md:p-5 text-center border border-slate-100 hover:border-[#0E3477] hover:shadow-md transition">
        <div class="text-2xl md:text-3xl font-bold text-[#0E3477] mb-2"><%= s.n %></div>
        <div class="text-sm md:text-base font-bold text-[#0F172A] mb-1"><%= s.t %></div>
        <div class="text-xs text-slate-500 leading-tight"><%= s.d %></div>
      </div>
      <% }); %>
    </div>
  </div>
</section>

