                  <p class="text-xs text-slate-300 leading-relaxed" x-text="result.desc"></p>
                  <p class="text-xs text-amber-400 font-semibold flex items-center justify-center sm:justify-start gap-1">
                    <i class="fa-solid fa-shield-halved"></i>
                    <span x-text="'Saran Kapasitas: ' + result.capacity"></span>
                  </p>
                </div>
              </div>
            </div>

            <div class="flex flex-col sm:flex-row gap-3 pt-2">
              <a :href="result.waLink" 
                 target="_blank" 
                 class="w-full sm:flex-1 inline-flex items-center justify-center gap-2 py-4 px-6 rounded-2xl font-bold text-white bg-gradient-to-r from-emerald-600 to-green-600 hover:from-emerald-500 hover:to-green-500 shadow-xl shadow-emerald-950/40 transition-all text-sm">
                <i class="fa-brands fa-whatsapp text-lg"></i>
                <span>Pesan / Minta Penawaran (WhatsApp)</span>
              </a>
              <button @click="resetQuiz()" type="button" class="py-4 px-6 rounded-2xl font-semibold text-slate-300 hover:text-white glass-card-dark border border-white/10 hover:bg-white/10 transition-all text-sm cursor-pointer">
                Ulangi Kuis
              </button>
            </div>
          </div>

        </div>

        <!-- Modal Navigation Footer -->
        <div x-show="step > 1 && step < 4" class="bg-slate-950/60 px-6 py-4 border-t border-white/10 flex justify-between items-center">
          <button @click="step--" type="button" class="text-xs font-bold text-slate-400 hover:text-white flex items-center gap-1.5 cursor-pointer">
            <i class="fa-solid fa-arrow-left"></i>
            <span>Kembali</span>
          </button>
        </div>

      </div>

    </div>

  </div>

</div>

<script>
  function aparQuiz() {
    return {
      quizOpen: false,
      step: 1,
      roomType: 'rumah',
      hazardType: 'general',
      areaSize: 'small',
      result: {
        name: 'Dry Chemical Powder 3kg',
        badge: 'Rekomendasi Utama',
        desc: 'Sangat cocok untuk proteksi kebakaran serbaguna kelas A, B, dan C.',
        capacity: '1 Unit Tabung 3 Kg',
        image: '/img/apar-powder-3kg.webp',
        waLink: '#'
      },
      openQuiz() {
        this.quizOpen = true;
        this.step = 1;
      },
      nextStep() {
        this.step++;
      },
      resetQuiz() {
        this.step = 1;
      },
      calculateResult() {
        this.step = 4;
        let aparName = 'Dry Chemical Powder 3kg';
        let capacity = '1 Unit 3 Kg';
        let img = '/img/apar-powder-3kg.webp';
        let desc = 'Sangat serbaguna untuk memadamkan kebakaran kayu, cairan, dan korsleting listrik.';

        if (this.roomType === 'server' || this.hazardType === 'electrical') {
          aparName = 'Carbon Dioxide (CO2) 6kg';
          capacity = this.areaSize === 'large' ? '2-3 Unit 6 Kg' : '1 Unit 6 Kg';
          img = '/img/apar-CO-6kg.webp';
          desc = 'Gas bersih tanpa residu, tidak menghantarkan listrik dan tidak merusak server/peralatan elektronik.';
        } else if (this.roomType === 'restoran' || this.hazardType === 'liquid_gas') {
          aparName = 'Media Foam (Busa AFFF) 6kg';
          capacity = this.areaSize === 'large' ? '2 Unit 6 Kg' : '1 Unit 6 Kg';
          img = '/img/apar-powder-6kg.webp';
          desc = 'Membentuk lapisan film pendingin di atas cairan/minyak panas untuk mencegah oksigen menyulut api kembali.';
        } else if (this.roomType === 'mobil') {
          aparName = 'Dry Chemical Powder 1kg - 2kg';
          capacity = '1 Unit 1-2 Kg Portable';
          img = '/img/apar-powder-3kg.webp';
          desc = 'Ukuran ringkas mudah ditempatkan di bawah kursi pengemudi atau bagasi kendaraan.';
        } else if (this.areaSize === 'large') {
          aparName = 'Dry Chemical Powder 6kg / 9kg';
          capacity = 'Minimal 2-4 Unit 6 Kg (Interval tiap 15 meter)';
          img = '/img/apar-powder-5kg.webp';
          desc = 'Kapasitas serbuk besar untuk jangkauan radius proteksi luas di gudang/pabrik.';
        }

        this.result = {
          name: aparName,
          badge: 'Sesuai Rekomendasi K3',
          desc: desc,
          capacity: capacity,
          image: img,
          waLink: 'https://wa.me/628112899009?text=' + encodeURIComponent('Halo PEMAPI, hasil Kuis Rekomendasi menyarankan: ' + aparName + ' (' + capacity + ') untuk ' + this.roomType + ' dengan luas ' + this.areaSize + '. Tolong kirimkan penawaran harga terbaik.')
        };
      }
    };
  }
</script>