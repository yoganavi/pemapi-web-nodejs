<!-- Hero -->
<section class="bg-gradient-to-br from-[#0B1220] via-[#0E2040] to-[#0E3477] text-white py-16">
  <div class="mx-auto w-11/12 xl:w-9/12">
    <div class="max-w-3xl">
      <div class="text-xs uppercase tracking-widest text-white/60 mb-3">Solusi Fire Protection</div>
      <h1 class="text-3xl md:text-5xl font-bold leading-tight mb-4">Bukan Sekadar APAR</h1>
      <p class="text-lg text-white/80">PEMAPI menyediakan empat layanan fire protection yang saling melengkapi — dari konsultasi awal hingga manajemen digital jangka panjang.</p>
    </div>
  </div>
</section>

<!-- Solusi Cards -->
<section class="bg-slate-50 py-16">
  <div class="mx-auto w-11/12 xl:w-9/12">
    <div class="grid md:grid-cols-2 gap-6">
      <% solusiList.forEach(function(s) { %>
      <a href="/solusi/<%= s.slug %>" class="group bg-white rounded-2xl border border-slate-200 p-6 md:p-8 hover:border-[#0E3477] hover:shadow-xl transition-all">
        <div class="text-4xl mb-4"><%= s.icon %></div>
        <h2 class="text-xl md:text-2xl font-bold text-[#0F172A] mb-2 group-hover:text-[#0E3477] transition"><%= s.title %></h2>
        <p class="text-slate-600 mb-4"><%= s.tagline %></p>
        <div class="text-sm font-semibold text-[#0E3477] group-hover:underline">Pelajari lebih lanjut →</div>
      </a>
      <% }); %>
    </div>
  </div>
</section>

<!-- CTA -->
<section class="bg-[#0B1220] py-16 text-center text-white">
  <div class="mx-auto w-11/12 xl:w-9/12">
    <h2 class="text-2xl md:text-3xl font-bold mb-3">Bingung mulai dari mana?</h2>
    <p class="text-white/70 mb-6">Konsultasikan kebutuhan Anda — kami akan bantu petakan solusi terbaik.</p>
    <div class="flex flex-wrap justify-center gap-3">
      <a href="/hubungi-kami" class="inline-flex items-center gap-2 bg-[#E63946] hover:bg-[#C1272D] text-white px-6 py-3 rounded-md font-semibold transition">Konsultasi Gratis →</a>
      <a href="/quiz-apar" class="inline-flex items-center gap-2 bg-amber-500 hover:bg-amber-600 text-white px-6 py-3 rounded-md font-semibold transition">🔥 Mulai Quiz APAR</a>
    </div>
  </div>
</section>
