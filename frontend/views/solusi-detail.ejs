<!-- Breadcrumb -->
<div class="bg-white border-b border-slate-100">
  <div class="mx-auto w-11/12 xl:w-9/12 py-3 text-xs text-slate-500">
    <a href="/" class="hover:text-[#0E3477]">Beranda</a>
    <span class="mx-2">→</span>
    <a href="/solusi" class="hover:text-[#0E3477]">Solusi</a>
    <span class="mx-2">→</span>
    <span class="text-slate-800"><%= solusi.title %></span>
  </div>
</div>

<!-- Hero -->
<section class="bg-white py-14">
  <div class="mx-auto w-11/12 xl:w-9/12">
    <div class="grid md:grid-cols-2 gap-10 items-center">
      <div>
        <div class="text-5xl mb-4"><%= solusi.icon %></div>
        <h1 class="text-3xl md:text-4xl font-bold text-[#0F172A] leading-tight mb-3"><%= solusi.title %></h1>
        <p class="text-lg text-slate-600 mb-6"><%= solusi.heroDesc %></p>
        <div class="flex flex-wrap gap-3">
          <a href="/hubungi-kami" class="inline-flex items-center gap-2 bg-[#E63946] hover:bg-[#C1272D] text-white px-6 py-3 rounded-md font-semibold transition"><%= solusi.ctaLabel %> →</a>
          <a href="<%= waLink('solusi', solusi.title) %>" target="_blank" rel="noopener" class="inline-flex items-center gap-2 bg-[#25D366] hover:bg-[#1DA851] text-white px-6 py-3 rounded-md font-semibold transition">
            <i class="fa-brands fa-whatsapp"></i> WhatsApp
          </a>
        </div>
      </div>
      <div class="bg-gradient-to-br from-slate-100 to-slate-200 rounded-2xl aspect-square md:aspect-video flex items-center justify-center">
        <div class="text-slate-400 text-sm">Ilustrasi <%= solusi.title %></div>
      </div>
    </div>
  </div>
</section>

<!-- Problem -->
<section class="bg-slate-50 py-14">
  <div class="mx-auto w-11/12 xl:w-9/12 max-w-4xl">
    <div class="bg-white rounded-2xl border-l-4 border-red-500 p-6 md:p-8">
      <div class="text-xs uppercase tracking-widest text-red-600 font-semibold mb-2">⚠️ Masalah</div>
      <p class="text-lg text-slate-700"><%= solusi.problem %></p>
    </div>
  </div>
</section>

<!-- Solution -->
<section class="bg-white py-14">
  <div class="mx-auto w-11/12 xl:w-9/12 max-w-4xl">
    <div class="bg-slate-50 rounded-2xl border-l-4 border-[#0E3477] p-6 md:p-8">
      <div class="text-xs uppercase tracking-widest text-[#0E3477] font-semibold mb-2">✓ Solusi PEMAPI</div>
      <p class="text-lg text-slate-700"><%= solusi.solution %></p>
    </div>
  </div>
</section>

<!-- Process -->
<section class="bg-slate-50 py-14">
  <div class="mx-auto w-11/12 xl:w-9/12">
    <div class="text-center mb-10">
      <h2 class="text-2xl md:text-3xl font-bold text-[#0F172A] mb-3">Cara Kerja Kami</h2>
      <p class="text-slate-600">Proses sederhana, hasil profesional.</p>
    </div>
    <div class="grid md:grid-cols-3 gap-4 max-w-5xl mx-auto">
      <% solusi.process.forEach(function(step) { %>
      <div class="bg-white rounded-xl border border-slate-200 p-6 relative">
        <div class="absolute -top-3 -left-3 w-12 h-12 rounded-full bg-[#0E3477] text-white flex items-center justify-center font-bold text-lg shadow-md"><%= step.num %></div>
        <h3 class="font-bold text-lg text-[#0F172A] mb-2 mt-3"><%= step.title %></h3>
        <p class="text-sm text-slate-600"><%= step.desc %></p>
      </div>
      <% }); %>
    </div>
  </div>
</section>

<!-- Why -->
<section class="bg-white py-14">
  <div class="mx-auto w-11/12 xl:w-9/12 max-w-4xl">
    <h2 class="text-2xl md:text-3xl font-bold text-[#0F172A] mb-6 text-center">Mengapa Memilih PEMAPI</h2>
    <div class="grid md:grid-cols-2 gap-3">
      <% solusi.why.forEach(function(reason) { %>
      <div class="flex items-start gap-3 bg-slate-50 rounded-lg p-4">
        <i class="fa-solid fa-check text-[#0E3477] mt-1"></i>
        <span class="text-slate-700"><%= reason %></span>
      </div>
      <% }); %>
    </div>
  </div>
</section>

<!-- Final CTA -->
<section class="bg-[#0B1220] py-14 text-center text-white">
  <div class="mx-auto w-11/12 xl:w-9/12">
    <h2 class="text-2xl md:text-3xl font-bold mb-3">Siap Memulai?</h2>
    <p class="text-white/70 mb-6">Konsultasikan kebutuhan Anda dengan tim PEMAPI — gratis, tanpa komitmen.</p>
    <div class="flex flex-wrap justify-center gap-3">
      <a href="/hubungi-kami" class="inline-flex items-center gap-2 bg-[#E63946] hover:bg-[#C1272D] text-white px-6 py-3 rounded-md font-semibold transition"><%= solusi.ctaLabel %> →</a>
      <a href="<%= waLink('solusi', solusi.title) %>" target="_blank" rel="noopener" class="inline-flex items-center gap-2 bg-[#25D366] hover:bg-[#1DA851] text-white px-6 py-3 rounded-md font-semibold transition">
        <i class="fa-brands fa-whatsapp"></i> WhatsApp
      </a>
    </div>
  </div>
</section>
