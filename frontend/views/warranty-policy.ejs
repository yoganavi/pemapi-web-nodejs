<div class="mobile-app min-h-screen bg-slate-50">

    <!-- HEADER -->
    <header class="relative overflow-hidden bg-gradient-to-br from-red-600 via-red-600 to-orange-500 px-5 pt-10 pb-8 text-white">

        <!-- Decorative circles -->
        <div class="absolute -right-12 -top-12 h-40 w-40 rounded-full bg-white/10"></div>
        <div class="absolute -left-16 bottom-[-50px] h-40 w-40 rounded-full bg-white/10"></div>

        <div class="relative z-10">

            <div class="mb-6 flex items-center justify-between">
                <div class="flex items-center gap-3">
                    <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-white shadow-lg">
                        <i data-lucide="flame-kindling"
                           class="h-6 w-6 text-red-600"></i>
                    </div>

                    <div>
                        <p class="text-xs font-medium text-red-100">
                            PT. Coco Profire Indonesia
                        </p>
                        <h1 class="text-lg font-bold tracking-tight">
                            PEMAPI
                        </h1>
                    </div>
                </div>

                <div class="rounded-full bg-white/15 px-3 py-1.5 text-xs font-semibold backdrop-blur">
                    GARANSI APAR
                </div>
            </div>

            <h2 class="text-2xl font-bold leading-tight">
                Ketentuan Garansi
                <br>
                Alat Pemadam Api Ringan
            </h2>

            <p class="mt-3 max-w-sm text-sm leading-relaxed text-red-50">
                Informasi singkat dan mudah dipahami mengenai garansi APAR
                dan kewajiban inspeksi berkala.
            </p>
        </div>
    </header>


    <!-- CONTENT -->
    <main class="px-4 py-5">

        <!-- INTRO -->
        <div class="mb-5 rounded-2xl border border-red-100 bg-white p-4 shadow-sm">
            <div class="flex gap-3">
                <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-red-50">
                    <i data-lucide="info"
                       class="h-5 w-5 text-red-600"></i>
                </div>

                <div>
                    <h3 class="font-bold text-slate-900">
                        Sebelum menggunakan garansi
                    </h3>

                    <p class="mt-1 text-sm leading-relaxed text-slate-500">
                        Dengan membeli APAR dari PT. Coco Profire Indonesia,
                        pembeli dianggap telah membaca dan menyetujui
                        ketentuan garansi berikut.
                    </p>
                </div>
            </div>
        </div>


        <!-- GARANSI UTAMA -->
        <section class="mb-5">

            <div class="mb-3 flex items-center gap-2">
                <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-red-100">
                    <i data-lucide="shield-check"
                       class="h-4 w-4 text-red-600"></i>
                </div>

                <h3 class="font-bold text-slate-900">
                    Garansi yang Didapat
                </h3>
            </div>


            <div class="grid grid-cols-2 gap-3">

                <!-- Pressure -->
                <div class="rounded-2xl border border-slate-100 bg-white p-4 shadow-sm">

                    <div class="mb-3 flex h-10 w-10 items-center justify-center rounded-xl bg-blue-50">
                        <i data-lucide="gauge"
                           class="h-5 w-5 text-blue-600"></i>
                    </div>

                    <p class="text-xs font-medium text-slate-400">
                        Garansi Pressure
                    </p>

                    <p class="mt-1 text-2xl font-extrabold text-slate-900">
                        1 Tahun
                    </p>

                    <p class="mt-1 text-xs leading-relaxed text-slate-500">
                        Sejak tanggal pembelian.
                    </p>
                </div>


                <!-- Media -->
                <div class="rounded-2xl border border-slate-100 bg-white p-4 shadow-sm">

                    <div class="mb-3 flex h-10 w-10 items-center justify-center rounded-xl bg-orange-50">
                        <i data-lucide="calendar-clock"
                           class="h-5 w-5 text-orange-600"></i>
                    </div>

                    <p class="text-xs font-medium text-slate-400">
                        Masa Media Pemadam
                    </p>

                    <p class="mt-1 text-2xl font-extrabold text-slate-900">
                        3 Tahun
                    </p>

                    <p class="mt-1 text-xs leading-relaxed text-slate-500">
                        Mengikuti tanggal produksi/refill terakhir.
                    </p>
                </div>

            </div>
        </section>


        <!-- INSPEKSI -->
        <section class="mb-5">

            <div class="mb-3 flex items-center gap-2">
                <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-emerald-100">
                    <i data-lucide="clipboard-check"
                       class="h-4 w-4 text-emerald-600"></i>
                </div>

                <h3 class="font-bold text-slate-900">
                    Wajib Inspeksi Berkala
                </h3>
            </div>


            <div class="overflow-hidden rounded-2xl bg-white shadow-sm">

                <div class="p-4">

                    <div class="flex items-start gap-4">

                        <div class="relative flex flex-col items-center">

                            <div class="flex h-12 w-12 items-center justify-center rounded-full bg-emerald-100">
                                <i data-lucide="smartphone"
                                   class="h-5 w-5 text-emerald-600"></i>
                            </div>

                            <div class="mt-2 h-8 w-px bg-slate-200"></div>

                            <div class="flex h-12 w-12 items-center justify-center rounded-full bg-blue-100">
                                <i data-lucide="calendar-days"
                                   class="h-5 w-5 text-blue-600"></i>
                            </div>

                        </div>


                        <div class="flex-1">

                            <h4 class="font-bold text-slate-900">
                                Inspeksi melalui Aplikasi PEMAPI
                            </h4>

                            <p class="mt-1 text-sm leading-relaxed text-slate-500">
                                APAR harus diperiksa secara berkala dengan
                                interval maksimal <strong class="text-slate-700">
                                3 bulan sekali</strong>.
                            </p>

                            <div class="mt-4 rounded-xl bg-emerald-50 p-3">

                                <div class="flex items-center gap-2">
                                    <i data-lucide="check-circle-2"
                                       class="h-4 w-4 text-emerald-600"></i>

                                    <span class="text-sm font-bold text-emerald-700">
                                        Gunakan Aplikasi PEMAPI
                                    </span>
                                </div>

                                <p class="mt-1 text-xs leading-relaxed text-emerald-700/70">
                                    Pastikan inspeksi dilakukan tepat waktu
                                    agar garansi tetap aktif.
                                </p>

                            </div>

                        </div>

                    </div>

                </div>

            </div>
        </section>


        <!-- SISTEM 3 BULAN -->
        <section class="mb-5">

            <div class="rounded-2xl bg-slate-900 p-5 text-white shadow-lg">

                <div class="flex items-center justify-between">

                    <div>
                        <p class="text-xs font-medium text-slate-400">
                            BATAS INSPEKSI
                        </p>

                        <p class="mt-1 text-xl font-bold">
                            Maksimal 3 Bulan
                        </p>
                    </div>

                    <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-white/10">
                        <i data-lucide="timer-reset"
                           class="h-6 w-6 text-white"></i>
                    </div>

                </div>


                <!-- Timeline -->
                <div class="mt-6 flex items-center">

                    <div class="flex flex-1 flex-col items-center">
                        <div class="flex h-8 w-8 items-center justify-center rounded-full bg-emerald-500 text-xs font-bold">
                            1
                        </div>

                        <p class="mt-2 text-[11px] text-slate-300">
                            Bulan 1
                        </p>
                    </div>

                    <div class="h-0.5 flex-1 bg-slate-600"></div>

                    <div class="flex flex-1 flex-col items-center">
                        <div class="flex h-8 w-8 items-center justify-center rounded-full bg-emerald-500 text-xs font-bold">
                            2
                        </div>

                        <p class="mt-2 text-[11px] text-slate-300">
                            Bulan 2
                        </p>
                    </div>

                    <div class="h-0.5 flex-1 bg-slate-600"></div>

                    <div class="flex flex-1 flex-col items-center">
                        <div class="flex h-8 w-8 items-center justify-center rounded-full bg-emerald-500 text-xs font-bold">
                            3
                        </div>

                        <p class="mt-2 text-[11px] text-slate-300">
                            Bulan 3
                        </p>
                    </div>

                    <div class="h-0.5 flex-1 bg-red-500"></div>

                    <div class="flex flex-1 flex-col items-center">
                        <div class="flex h-8 w-8 items-center justify-center rounded-full bg-red-500 text-xs font-bold">
                            4
                        </div>

                        <p class="mt-2 text-[11px] font-bold text-red-400">
                            Hangus
                        </p>
                    </div>

                </div>

            </div>
        </section>


        <!-- PERHATIAN -->
        <section class="mb-5">

            <div class="rounded-2xl border border-red-200 bg-red-50 p-4">

                <div class="flex gap-3">

                    <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-red-100">
                        <i data-lucide="triangle-alert"
                           class="h-5 w-5 text-red-600"></i>
                    </div>

                    <div>

                        <h3 class="font-bold text-red-700">
                            Kapan Garansi Hangus?
                        </h3>

                        <p class="mt-1 text-sm leading-relaxed text-red-700/80">
                            Jika sudah masuk <strong>bulan ke-4</strong> dan
                            inspeksi belum dilakukan, maka garansi pressure
                            dan jaminan masa media pemadam
                            <strong>otomatis hangus</strong>.
                        </p>

                    </div>

                </div>


                <div class="mt-3 rounded-xl bg-white/70 p-3">

                    <div class="flex items-center gap-2">

                        <i data-lucide="clock-3"
                           class="h-4 w-4 text-red-600"></i>

                        <p class="text-xs font-semibold text-red-700">
                            Contoh:
                        </p>

                    </div>

                    <p class="mt-1 text-xs leading-relaxed text-red-700/70">
                        Inspeksi terakhir dilakukan bulan Januari.
                        Inspeksi berikutnya harus dilakukan paling lambat
                        bulan April. Jika sudah masuk bulan Mei dan belum
                        inspeksi, garansi dinyatakan hangus.
                    </p>

                </div>

            </div>

        </section>


        <!-- CATATAN BULAN KALENDER -->
        <section class="mb-5">

            <div class="rounded-2xl border border-amber-200 bg-amber-50 p-4">

                <div class="flex gap-3">

                    <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-amber-100">
                        <i data-lucide="calendar-range"
                           class="h-5 w-5 text-amber-600"></i>
                    </div>

                    <div>

                        <h3 class="font-bold text-amber-800">
                            Perhitungan Menggunakan Bulan Kalender
                        </h3>

                        <p class="mt-1 text-sm leading-relaxed text-amber-800/75">
                            Bukan berdasarkan jumlah hari.
                            Jadi ketika sudah memasuki bulan ke-4,
                            walaupun baru <strong>1 hari</strong>,
                            garansi sudah dianggap hangus jika inspeksi
                            belum dilakukan.
                        </p>

                    </div>

                </div>

            </div>

        </section>


        <!-- GARANSI AKTIF KEMBALI -->
        <section class="mb-5">

            <div class="mb-3 flex items-center gap-2">

                <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-blue-100">
                    <i data-lucide="refresh-cw"
                       class="h-4 w-4 text-blue-600"></i>
                </div>

                <h3 class="font-bold text-slate-900">
                    Bagaimana Garansi Aktif Kembali?
                </h3>

            </div>


            <div class="rounded-2xl bg-white p-4 shadow-sm">

                <p class="text-sm leading-relaxed text-slate-600">
                    Jika garansi sudah hangus karena terlambat inspeksi,
                    garansi dapat diberlakukan kembali setelah APAR menjalani
                    <strong class="text-slate-900">
                        maintenance atau refill
                    </strong>
                    oleh PT. Coco Profire Indonesia atau teknisi resmi yang
                    ditunjuk.
                </p>


                <div class="mt-4 grid grid-cols-2 gap-3">

                    <div class="rounded-xl bg-blue-50 p-3 text-center">

                        <div class="mx-auto flex h-10 w-10 items-center justify-center rounded-full bg-blue-100">
                            <i data-lucide="wrench"
                               class="h-5 w-5 text-blue-600"></i>
                        </div>

                        <p class="mt-2 text-xs font-bold text-blue-800">
                            Maintenance
                        </p>

                    </div>


                    <div class="rounded-xl bg-emerald-50 p-3 text-center">

                        <div class="mx-auto flex h-10 w-10 items-center justify-center rounded-full bg-emerald-100">
                            <i data-lucide="cylinder"
                               class="h-5 w-5 text-emerald-600"></i>
                        </div>

                        <p class="mt-2 text-xs font-bold text-emerald-800">
                            Refill
                        </p>

                    </div>

                </div>


                <div class="mt-4 rounded-xl bg-slate-50 p-3">

                    <div class="flex items-start gap-2">

                        <i data-lucide="badge-check"
                           class="mt-0.5 h-4 w-4 shrink-0 text-emerald-600"></i>

                        <p class="text-xs leading-relaxed text-slate-500">
                            Setelah APAR diperiksa dan dinyatakan memenuhi
                            standar, masa garansi akan berlaku kembali
                            sejak tanggal maintenance atau refill.
                        </p>

                    </div>

                </div>

            </div>

        </section>


        <!-- SUMMARY -->
        <section class="mb-6">

            <div class="overflow-hidden rounded-2xl bg-gradient-to-br from-red-600 to-orange-500 p-5 text-white shadow-lg">

                <div class="flex items-center gap-3">

                    <div class="flex h-11 w-11 items-center justify-center rounded-full bg-white/15">
                        <i data-lucide="shield"
                           class="h-6 w-6"></i>
                    </div>

                    <div>
                        <h3 class="font-bold">
                            Intinya, jangan lupa inspeksi!
                        </h3>

                        <p class="mt-0.5 text-xs text-red-100">
                            Inspeksi rutin = APAR terpantau & garansi tetap terjaga.
                        </p>
                    </div>

                </div>


                <div class="mt-4 space-y-2">

                    <div class="flex items-center gap-2 text-sm">
                        <i data-lucide="check"
                           class="h-4 w-4"></i>
                        <span>Pressure bergaransi 1 tahun</span>
                    </div>

                    <div class="flex items-center gap-2 text-sm">
                        <i data-lucide="check"
                           class="h-4 w-4"></i>
                        <span>Media pemadam berlaku 3 tahun</span>
                    </div>

                    <div class="flex items-center gap-2 text-sm">
                        <i data-lucide="check"
                           class="h-4 w-4"></i>
                        <span>Inspeksi maksimal setiap 3 bulan</span>
                    </div>

                    <div class="flex items-center gap-2 text-sm">
                        <i data-lucide="check"
                           class="h-4 w-4"></i>
                        <span>Inspeksi dilakukan melalui PEMAPI</span>
                    </div>

                </div>

            </div>

        </section>


        <!-- FOOTER -->
        <footer class="safe-bottom pb-5 text-center">

            <div class="mx-auto mb-3 flex h-10 w-10 items-center justify-center rounded-xl bg-red-100">
                <i data-lucide="flame"
                   class="h-5 w-5 text-red-600"></i>
            </div>

            <p class="text-xs font-bold text-slate-700">
                PT. Coco Profire Indonesia
            </p>

            <p class="mt-1 text-[11px] text-slate-400">
                Penyedia APAR & layanan pemeliharaan APAR
            </p>

            <p class="mt-3 text-[10px] text-slate-400">
                Dengan menggunakan layanan kami, pembeli dianggap telah
                memahami dan menyetujui ketentuan garansi yang berlaku.
            </p>

        </footer>

    </main>

</div>


