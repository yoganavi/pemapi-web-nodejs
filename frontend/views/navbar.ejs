<script>
  document.addEventListener('DOMContentLoaded', () => {
    const currentPath = window.location.pathname;
    const links = document.querySelectorAll('.nav-menu-items .nav-link');

    links.forEach(link => {
      const linkPath = link.getAttribute('href');
      const isMatch = (currentPath === '/' && linkPath === '/') || 
                      (linkPath !== '/' && currentPath.startsWith(linkPath));

      if (isMatch) {
        link.classList.remove('text-slate-300', 'text-slate-200');
        link.classList.add('bg-blue-600/20', 'text-white', 'border', 'border-blue-500/30', 'font-semibold');
      }
    });
  });
</script>