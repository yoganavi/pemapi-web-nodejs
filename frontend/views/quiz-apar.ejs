<div class="bg-slate-50 min-h-screen py-10 md:py-16">
  <div class="mx-auto max-w-2xl px-4 sm:px-6">

    <!-- Header -->
    <div class="text-center mb-8">
      <div class="inline-flex items-center gap-2 bg-amber-100 text-amber-800 rounded-full px-4 py-1.5 text-xs font-semibold uppercase tracking-wider mb-3">
        <span>🔥</span> Quiz APAR
      </div>
      <h1 class="text-3xl md:text-4xl font-bold text-[#0F172A] mb-2">Temukan APAR yang Tepat</h1>
      <p class="text-slate-600">Jawab 7 pertanyaan sederhana untuk mendapat rekomendasi awal. Tidak perlu registrasi.</p>
      <div class="flex justify-center gap-6 mt-4 text-xs text-slate-500">
        <span>⏱️ ~2 menit</span>
        <span>📋 7 pertanyaan</span>
        <span>🔒 Tanpa data pribadi</span>
      </div>
    </div>

    <!-- Quiz card -->
    <div id="quiz-app" class="bg-white rounded-2xl shadow-sm border border-slate-200 p-6 md:p-8">
      <!-- Progress -->
      <div id="quiz-progress-wrap" class="mb-6">
        <div class="flex justify-between items-center mb-2 text-xs text-slate-500">
          <span id="quiz-count">Pertanyaan 1 dari 7</span>
          <span id="quiz-percent">14%</span>
        </div>
        <div class="h-2 bg-slate-100 rounded-full overflow-hidden">
          <div id="quiz-bar" class="h-full bg-gradient-to-r from-[#0E3477] to-[#1D5A9E] transition-all duration-500" style="width:14%"></div>
        </div>
      </div>

      <!-- Body -->
      <div id="quiz-body"></div>

      <!-- Nav -->
      <div id="quiz-nav" class="flex justify-between items-center mt-6 pt-6 border-t border-slate-100">
        <button id="quiz-back" class="text-slate-500 hover:text-slate-900 disabled:opacity-40 disabled:cursor-not-allowed text-sm font-semibold" disabled>← Kembali</button>
        <button id="quiz-next" class="bg-[#E63946] hover:bg-[#C1272D] text-white px-6 py-2.5 rounded-md text-sm font-semibold transition disabled:bg-slate-300 disabled:cursor-not-allowed shadow-sm hover:shadow-md" disabled>Selanjutnya →</button>
      </div>
    </div>

    <!-- Disclaimer -->
    <p class="text-xs text-slate-500 text-center mt-4 max-w-md mx-auto">Hasil rekomendasi bersifat indikatif. Untuk penentuan akurat sesuai kondisi lapangan, konsultasikan dengan tim PEMAPI.</p>
  </div>
</div>

<script>
const quizQuestions = [
  {
    q: "Berapa luas total area yang perlu dilindungi APAR?",
    key: "area",
    opts: [
      { t: "Kurang dari 100 m² (ruko, kantor kecil, toko)", v: "small" },
      { t: "100 – 500 m² (kantor menengah, restoran, gudang kecil)", v: "medium" },
      { t: "Lebih dari 500 m² (pabrik, gudang besar, gedung bertingkat)", v: "large" }
    ]
  },
  {
    q: "Berapa lantai/level bangunan Anda?",
    key: "floors",
    opts: [
      { t: "1 lantai", v: 1 },
      { t: "2 – 3 lantai", v: 2.5 },
      { t: "Lebih dari 3 lantai", v: 4 }
    ]
  },
  {
    q: "Apa material dominan yang ada di area tersebut?",
    key: "material",
    opts: [
      { t: "Kertas, kayu, dan bahan padat lainnya", v: "solid" },
      { t: "Cairan mudah terbakar (bensin, minyak, pelarut)", v: "liquid" },
      { t: "Peralatan elektronik dan kabel", v: "electric" },
      { t: "Campuran beberapa material di atas", v: "mixed" },
      { t: "Tidak yakin, perlu bantuan menentukan", v: "unknown" }
    ]
  },
  {
    q: "Apakah ada peralatan elektronik penting atau ruang server?",
    key: "electronics",
    opts: [
      { t: "Ya, ada ruang server atau peralatan elektronik kritis", v: "yes" },
      { t: "Ada peralatan biasa tapi tidak kritis", v: "some" },
      { t: "Tidak ada", v: "no" }
    ]
  },
  {
    q: "Apakah ada area khusus (data center, laboratorium, arsip penting)?",
    key: "special",
    opts: [
      { t: "Ya, ada area yang butuh perlindungan bersih (nol residu)", v: "yes" },
      { t: "Tidak ada area khusus", v: "no" }
    ]
  },
  {
    q: "Apakah Anda butuh layanan maintenance dan refill berkala?",
    key: "maintenance",
    opts: [
      { t: "Ya, sudah waktunya refill atau setup jadwal rutin", v: "yes" },
      { t: "Belum, hanya butuh APAR baru", v: "no" },
      { t: "Belum tahu, ingin konsultasi lebih lanjut", v: "consult" }
    ]
  },
  {
    q: "Kapan Anda berencana implementasi?",
    key: "timing",
    opts: [
      { t: "Segera (dalam 1 bulan)", v: "urgent" },
      { t: "1 – 3 bulan ke depan", v: "soon" },
      { t: "Masih dalam tahap eksplorasi", v: "explore" }
    ]
  }
];

let state = { current: 0, answers: {} };

function renderQuiz() {
  if (state.current >= quizQuestions.length) return renderResult();
  const q = quizQuestions[state.current];
  const answer = state.answers[q.key];
  const body = document.getElementById('quiz-body');
  body.innerHTML = `
    <h2 class="text-xl md:text-2xl font-bold text-[#0F172A] mb-5 leading-tight">${q.q}</h2>
    <div class="space-y-2">
      ${q.opts.map(o => `
        <label class="flex items-center gap-3 p-4 border-2 rounded-lg cursor-pointer transition ${JSON.stringify(answer)===JSON.stringify(o.v) ? 'border-[#0E3477] bg-blue-50 text-[#0E3477] font-medium ring-2 ring-[#0E3477]/10' : 'border-slate-200 hover:border-slate-400 hover:bg-slate-50 text-slate-700'}" data-val='${JSON.stringify(o.v)}'>
          <div class="w-5 h-5 rounded-full border-2 shrink-0 ${JSON.stringify(answer)===JSON.stringify(o.v) ? 'border-[#0E3477] bg-[#0E3477] ring-4 ring-inset ring-white' : 'border-slate-300'}"></div>
          <div class="flex-1">${o.t}</div>
        </label>
      `).join('')}
    </div>
  `;
  body.querySelectorAll('label').forEach(label => {
    label.addEventListener('click', () => {
      const val = JSON.parse(label.dataset.val);
      state.answers[q.key] = val;
      renderQuiz();
    });
  });
  const pct = Math.round(((state.current + 1) / quizQuestions.length) * 100);
  document.getElementById('quiz-count').textContent = `Pertanyaan ${state.current + 1} dari ${quizQuestions.length}`;
  document.getElementById('quiz-percent').textContent = `${pct}%`;
  document.getElementById('quiz-bar').style.width = `${pct}%`;
  document.getElementById('quiz-back').disabled = state.current === 0;
  document.getElementById('quiz-next').disabled = state.answers[q.key] === undefined;
  document.getElementById('quiz-next').textContent = state.current === quizQuestions.length - 1 ? 'Lihat Rekomendasi →' : 'Selanjutnya →';
}

function computeRecommendation() {
  const a = state.answers;
  let type, typeDesc, productSlug, capacity;

  if (a.special === 'yes') {
    type = 'APAR Clean Agent';
    typeDesc = 'Perlindungan bersih tanpa residu untuk area sensitif — data center, laboratorium, arsip penting.';
    productSlug = 'halon';
  } else if (a.electronics === 'yes' || a.material === 'electric') {
    type = 'APAR CO2';
    typeDesc = 'Efektif untuk peralatan elektronik dan ruang server — tidak meninggalkan residu.';
    productSlug = 'co2';
  } else if (a.material === 'liquid') {
    type = 'APAR Foam';
    typeDesc = 'Efektif untuk kebakaran cairan yang mudah terbakar — mencegah re-ignition.';
    productSlug = 'foam';
  } else {
    type = 'APAR Powder';
    typeDesc = 'Perlindungan serbaguna untuk kebakaran kelas A, B, dan C — cocok untuk mayoritas kebutuhan komersial.';
    productSlug = 'powder';
  }

  if (a.area === 'small') capacity = '3 kg';
  else if (a.area === 'medium') capacity = '6 kg';
  else capacity = '9 kg';

  const areaMap = { small: 80, medium: 300, large: 800 };
  const areaValue = areaMap[a.area];
  const quantity = Math.max(2, Math.ceil((areaValue * a.floors) / 100));

  let placement = 'Setiap lantai dan area kerja utama, jarak maksimal 15 meter antar unit.';
  if (a.material === 'liquid') placement = 'Dekat area penyimpanan cairan mudah terbakar.';
  if (a.electronics === 'yes') placement = 'Dekat area server dan panel listrik utama.';
  if (a.special === 'yes') placement = 'Di dalam ruang khusus (data center/lab) + area akses.';

  const uncertain = a.material === 'unknown' || a.material === 'mixed';
  return { type, typeDesc, capacity, quantity, placement, productSlug, uncertain };
}

function renderResult() {
  const r = computeRecommendation();
  const waMsg = encodeURIComponent(`Halo PEMAPI, saya baru selesai Quiz APAR dan mendapat rekomendasi: ${r.type} ${r.capacity}, ${r.quantity} unit. Mohon konsultasi untuk validasi rekomendasi ini. Terima kasih.`);
  document.getElementById('quiz-progress-wrap').style.display = 'none';
  document.getElementById('quiz-body').innerHTML = `
    <div class="text-center">
      <div class="inline-flex items-center gap-2 bg-emerald-100 text-emerald-800 rounded-full px-4 py-1.5 text-xs font-semibold uppercase tracking-wider mb-4">✓ Selesai</div>
      <h2 class="text-2xl md:text-3xl font-bold text-[#0F172A] mb-2">Rekomendasi APAR Anda</h2>
      <p class="text-slate-500 text-sm mb-6">Berdasarkan jawaban yang Anda berikan</p>
    </div>

    <div class="bg-gradient-to-br from-blue-50 to-indigo-50 border-2 border-[#0E3477] rounded-2xl p-6 mb-4">
      <div class="text-center mb-5">
        <div class="text-3xl md:text-4xl font-bold text-[#0E3477] mb-1">${r.type}</div>
        <p class="text-sm text-slate-600 max-w-md mx-auto">${r.typeDesc}</p>
      </div>

      <div class="bg-white rounded-xl border border-slate-200 divide-y divide-slate-100">
        <div class="flex justify-between items-center px-4 py-3">
          <span class="text-sm font-semibold text-slate-600">Jenis</span>
          <span class="text-sm font-bold text-[#0E3477]">${r.type}</span>
        </div>
        <div class="flex justify-between items-center px-4 py-3">
          <span class="text-sm font-semibold text-slate-600">Kapasitas per unit</span>
          <span class="text-sm font-bold text-[#0E3477]">${r.capacity}</span>
        </div>
        <div class="flex justify-between items-center px-4 py-3">
          <span class="text-sm font-semibold text-slate-600">Estimasi jumlah</span>
          <span class="text-sm font-bold text-[#0E3477]">${r.quantity} unit</span>
        </div>
        <div class="flex justify-between items-start px-4 py-3 gap-3">
          <span class="text-sm font-semibold text-slate-600 shrink-0">Penempatan</span>
          <span class="text-sm text-slate-700 text-right">${r.placement}</span>
        </div>
      </div>
    </div>

    ${r.uncertain
      ? `<div class="bg-amber-50 border border-amber-200 rounded-lg p-3 text-sm text-amber-900 mb-4">
          <strong>⚠️ Catatan:</strong> Jawaban Anda menunjukkan ketidakpastian material. Kami sangat menyarankan konsultasi langsung untuk penentuan yang lebih akurat.
        </div>`
      : `<p class="text-xs text-slate-500 italic mb-4 text-center">Rekomendasi bersifat indikatif. Konsultasikan dengan tim PEMAPI untuk penentuan akurat sesuai kondisi lapangan.</p>`
    }

    <div class="flex flex-col sm:flex-row gap-2 justify-center">
      <a href="https://wa.me/628112899009?text=${waMsg}" target="_blank" rel="noopener" class="inline-flex items-center justify-center gap-2 bg-[#25D366] hover:bg-[#1DA851] text-white px-6 py-3 rounded-md font-semibold transition">
        <i class="fa-brands fa-whatsapp"></i> Konsultasikan Hasil
      </a>
      <a href="/product-apar?tipe=${r.productSlug}" class="inline-flex items-center justify-center gap-2 border-2 border-[#0E3477] text-[#0E3477] hover:bg-[#0E3477] hover:text-white px-6 py-3 rounded-md font-semibold transition">
        Lihat ${r.type}
      </a>
      <button onclick="resetQuiz()" class="inline-flex items-center justify-center gap-2 text-slate-500 hover:text-slate-800 px-4 py-3 text-sm font-medium">
        Ulangi Quiz
      </button>
    </div>
  `;
  document.getElementById('quiz-nav').style.display = 'none';
}

function resetQuiz() {
  state = { current: 0, answers: {} };
  document.getElementById('quiz-progress-wrap').style.display = 'block';
  document.getElementById('quiz-nav').style.display = 'flex';
  renderQuiz();
}

document.getElementById('quiz-back').addEventListener('click', () => {
  if (state.current > 0) { state.current--; renderQuiz(); }
});
document.getElementById('quiz-next').addEventListener('click', () => {
  state.current++;
  renderQuiz();
});

renderQuiz();
</script>
