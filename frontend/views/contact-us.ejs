<!-- Hero -->
<section class="bg-gradient-to-br from-[#0B1220] via-[#0E2040] to-[#0E3477] text-white py-14 md:py-20">
  <div class="mx-auto w-11/12 xl:w-9/12">
    <div class="max-w-3xl">
      <div class="text-xs uppercase tracking-widest text-white/60 mb-3">Hubungi Kami</div>
      <h1 class="text-3xl md:text-5xl font-bold leading-tight mb-4">Diskusikan Kebutuhan Anda</h1>
      <p class="text-lg text-white/80">Konsultasi gratis, tanpa komitmen. Tim kami akan merespons dalam 1x24 jam kerja.</p>
    </div>
  </div>
</section>

<!-- Contact -->
<section class="bg-slate-50 py-14">
  <div class="mx-auto w-11/12 xl:w-9/12">

    <!-- Alert -->
    <% if (typeof alert !== 'undefined' && alert) { %>
      <div class="mb-6 rounded-lg border-l-4 p-4 text-sm <%= alert === 'success' ? 'bg-emerald-50 border-emerald-500 text-emerald-900' : 'bg-red-50 border-red-500 text-red-900' %>">
        <% if (alert === 'success') { %>
          <strong>✓ Pesan Terkirim!</strong> Terima kasih. Tim PEMAPI akan menghubungi Anda dalam 1x24 jam kerja.
          <% if (typeof leadType !== 'undefined' && leadType) { %>
            <script>pemapiTrack('generate_lead', { form: 'contact', lead_type: <%- JSON.stringify(leadType).replace(/</g, '\\u003c') %> });</script>
          <% } %>
        <% } else { %>
          <strong>⚠️ Pesan gagal terkirim.</strong> Periksa kembali isian form Anda dan coba lagi. Atau hubungi kami langsung via WhatsApp.
        <% } %>
      </div>
    <% } %>

    <div class="grid lg:grid-cols-5 gap-6 lg:gap-8">
      <!-- Contact Info (left on desktop, first on mobile per Phase 6 mobile rule) -->
      <div class="lg:col-span-2 order-1">
        <div class="bg-white rounded-2xl border border-slate-200 p-6 md:p-7">
          <h2 class="text-xl font-bold text-[#0F172A] mb-5">Informasi Kontak</h2>

          <div class="space-y-4 mb-6">
            <div class="flex items-start gap-3">
              <div class="w-10 h-10 rounded-full bg-emerald-50 text-emerald-600 flex items-center justify-center shrink-0 mt-0.5">
                <i class="fa-brands fa-whatsapp text-lg"></i>
              </div>
              <div>
                <div class="text-xs uppercase tracking-wider text-slate-500 mb-0.5">WhatsApp</div>
                <a href="<%= waLink('konsultasi') %>" target="_blank" rel="noopener" class="text-[#0E3477] font-semibold hover:underline">0811-2899-009</a>
              </div>
            </div>

            <div class="flex items-start gap-3">
              <div class="w-10 h-10 rounded-full bg-blue-50 text-blue-600 flex items-center justify-center shrink-0 mt-0.5">
                <i class="fa-solid fa-envelope"></i>
              </div>
              <div>
                <div class="text-xs uppercase tracking-wider text-slate-500 mb-0.5">Email</div>
                <a href="mailto:cocoprofire@gmail.com?subject=Penawaran%20APAR" class="text-[#0E3477] font-semibold hover:underline break-all">cocoprofire@gmail.com</a>
              </div>
            </div>

            <div class="flex items-start gap-3">
              <div class="w-10 h-10 rounded-full bg-red-50 text-red-600 flex items-center justify-center shrink-0 mt-0.5">
                <i class="fa-solid fa-location-dot"></i>
              </div>
              <div>
                <div class="text-xs uppercase tracking-wider text-slate-500 mb-0.5">Alamat</div>
                <a href="https://maps.app.goo.gl/3ypNJb5BubCRbD9T8" target="_blank" rel="noopener" class="text-slate-700 text-sm leading-relaxed hover:text-[#0E3477]">
                  Jl. Puspanjolo Dalam 5 No. 10<br>
                  RT 011 / RW 001, Cabean<br>
                  Kec. Semarang Barat<br>
                  Kota Semarang, Jawa Tengah 50141
                </a>
              </div>
            </div>

            <div class="flex items-start gap-3">
              <div class="w-10 h-10 rounded-full bg-amber-50 text-amber-600 flex items-center justify-center shrink-0 mt-0.5">
                <i class="fa-regular fa-clock"></i>
              </div>
              <div>
                <div class="text-xs uppercase tracking-wider text-slate-500 mb-0.5">Jam Operasional</div>
                <div class="text-sm text-slate-700 leading-relaxed">
                  Sen–Jum 09.00–16.00<br>
                  Sabtu 09.00–13.00<br>
                  <span class="text-slate-400">Minggu / Tanggal merah libur</span>
                </div>
              </div>
            </div>
          </div>

          <a href="<%= waLink('konsultasi') %>" target="_blank" rel="noopener" class="block w-full text-center bg-[#25D366] hover:bg-[#1DA851] text-white py-3 rounded-md font-semibold transition">
            <i class="fa-brands fa-whatsapp me-2"></i> WhatsApp Langsung
          </a>
        </div>

        <!-- Social -->
        <div class="flex gap-2 mt-4 justify-center lg:justify-start">
          <a href="https://www.instagram.com/pemapi.indonesia/" target="_blank" rel="noopener" class="w-10 h-10 rounded-full bg-white border border-slate-200 hover:border-[#0E3477] flex items-center justify-center transition" aria-label="Instagram">
            <i class="fa-brands fa-instagram text-slate-600"></i>
          </a>
          <a href="https://www.facebook.com/aparpemapi/" target="_blank" rel="noopener" class="w-10 h-10 rounded-full bg-white border border-slate-200 hover:border-[#0E3477] flex items-center justify-center transition" aria-label="Facebook">
            <i class="fa-brands fa-facebook-f text-slate-600"></i>
          </a>
        </div>
      </div>

      <!-- Form (right on desktop, second on mobile) -->
      <div class="lg:col-span-3 order-2">
        <div class="bg-white rounded-2xl border border-slate-200 p-6 md:p-8">
          <h2 class="text-xl font-bold text-[#0F172A] mb-1">Kirim Pesan</h2>
          <p class="text-sm text-slate-500 mb-6">Isi form di bawah dan tim kami akan menghubungi Anda.</p>

          <form x-data="{ submitting: false }" @submit="submitting = true" action="/contact-us/submit" method="post" class="space-y-4">
            <!-- Honeypot (spam protection — hidden from users) -->
            <div style="position:absolute;left:-9999px;" aria-hidden="true">
              <label for="website">Website</label>
              <input type="text" name="website" tabindex="-1" autocomplete="off">
            </div>

            <div class="grid md:grid-cols-2 gap-4">
              <div>
                <label class="block text-sm font-medium text-slate-700 mb-1.5">Nama Lengkap <span class="text-red-500">*</span></label>
                <input type="text" name="nama" required minlength="2" class="w-full px-4 py-2.5 border-2 border-slate-200 rounded-lg text-sm focus:outline-none focus:border-[#0E3477] focus:ring-2 focus:ring-[#0E3477]/10 transition" placeholder="Nama Anda">
              </div>
              <div>
                <label class="block text-sm font-medium text-slate-700 mb-1.5">Perusahaan</label>
                <input type="text" name="perusahaan" class="w-full px-4 py-2.5 border-2 border-slate-200 rounded-lg text-sm focus:outline-none focus:border-[#0E3477] focus:ring-2 focus:ring-[#0E3477]/10 transition" placeholder="Nama perusahaan (opsional)">
              </div>
            </div>

            <div>
              <label class="block text-sm font-medium text-slate-700 mb-1.5">WhatsApp / Telepon <span class="text-red-500">*</span></label>
              <input type="tel" name="phone" required pattern="[0-9+\-\s()]{10,}" class="w-full px-4 py-2.5 border-2 border-slate-200 rounded-lg text-sm focus:outline-none focus:border-[#0E3477] focus:ring-2 focus:ring-[#0E3477]/10 transition" placeholder="0812-xxxx-xxxx">
            </div>

            <div>
              <label class="block text-sm font-medium text-slate-700 mb-1.5">Email</label>
              <input type="email" name="email" class="w-full px-4 py-2.5 border-2 border-slate-200 rounded-lg text-sm focus:outline-none focus:border-[#0E3477] focus:ring-2 focus:ring-[#0E3477]/10 transition" placeholder="email@perusahaan.com (opsional)">
            </div>

            <div>
              <label class="block text-sm font-medium text-slate-700 mb-1.5">Jenis Kebutuhan <span class="text-red-500">*</span></label>
              <select name="kebutuhan" required class="w-full px-4 py-2.5 border-2 border-slate-200 rounded-lg text-sm focus:outline-none focus:border-[#0E3477] focus:ring-2 focus:ring-[#0E3477]/10 transition bg-white">
                <option value="">Pilih kebutuhan Anda...</option>
                <option value="Konsultasi & Pemilihan APAR">Konsultasi & Pemilihan APAR</option>
                <option value="Beli APAR">Beli APAR</option>
                <option value="Refill & Maintenance">Refill & Maintenance</option>
                <option value="Manajemen APAR Digital">Manajemen APAR Digital (PEMAPI App)</option>
                <option value="Lainnya">Lainnya</option>
              </select>
            </div>

            <div>
              <label class="block text-sm font-medium text-slate-700 mb-1.5">Pesan <span class="text-red-500">*</span></label>
              <textarea name="pesan" required minlength="10" rows="4" class="w-full px-4 py-2.5 border-2 border-slate-200 rounded-lg text-sm focus:outline-none focus:border-[#0E3477] focus:ring-2 focus:ring-[#0E3477]/10 transition" placeholder="Ceritakan kebutuhan Anda..."></textarea>
            </div>

            <button type="submit" :disabled="submitting" class="w-full bg-[#E63946] hover:bg-[#C1272D] disabled:bg-slate-400 disabled:cursor-not-allowed text-white font-semibold py-3 rounded-md transition shadow-sm hover:shadow-md">
              <span x-show="!submitting">Kirim Pesan →</span>
              <span x-show="submitting"><i class="fa-solid fa-spinner fa-spin me-2"></i> Mengirim...</span>
            </button>

            <p class="text-xs text-slate-400 text-center">Dengan mengirim pesan, Anda menyetujui <a href="/privacy-policy" class="underline hover:text-[#0E3477]">kebijakan privasi</a> kami.</p>
          </form>
        </div>
      </div>
    </div>

    <!-- Map -->
    <div class="mt-8 rounded-2xl overflow-hidden border border-slate-200 shadow-sm">
      <iframe
        src="https://maps.google.com/maps?q=Jl.%20Puspanjolo%20Dalam%205%20No.10%2C%20Semarang%20Barat&z=16&output=embed"
        width="100%"
        height="350"
        style="border:0;"
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        title="Lokasi PEMAPI"></iframe>
    </div>
  </div>
</section>
