<div x-data="{ isSubmitting: false, messageTopic: '' }" class="bg-slate-950 text-slate-100 py-12 lg:py-20 px-4 sm:px-6 lg:px-8">
  <div class="max-w-7xl mx-auto space-y-16">
    
    <!-- Hero Title -->
    <div class="text-center max-w-3xl mx-auto space-y-4">
      <span class="text-xs font-bold uppercase tracking-wider px-3.5 py-1.5 rounded-full bg-red-600/20 text-red-400 border border-red-500/30 inline-block">
        Layanan Pelanggan & Konsultasi
      </span>
      <h1 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight">
        Hubungi Tim Ahli <span class="bg-gradient-to-r from-red-500 via-rose-400 to-amber-400 bg-clip-text text-transparent">PEMAPI</span>
      </h1>
      <p class="text-slate-400 text-sm sm:text-base leading-relaxed">
        Punya pertanyaan seputar pemilihan APAR, survei lokasi gedung, jadwal pengisian ulang (refill), atau bantuan aplikasi PEMAPI? Kami siap melayani Anda.
      </p>
    </div>

    <!-- Main Grid: Info Cards + Form -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
      
      <!-- Left Info Channels (5 Cols) -->
      <div class="lg:col-span-5 space-y-6">
        
        <!-- Live Status Card -->
        <div class="glass-card-dark rounded-3xl p-6 border border-white/10 space-y-4">
          <div class="flex items-center justify-between">
            <span class="text-xs font-bold text-slate-400 uppercase tracking-wider">Status Operasional</span>
            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 text-xs font-semibold">
              <span class="size-2 rounded-full bg-emerald-400 animate-pulse"></span>
              Buka Sekarang
            </span>
          </div>
          <p class="text-xs text-slate-300">
            <strong>Jam Kerja Kantor:</strong> Senin - Sabtu, 08:00 - 17:00 WIB<br>
            <span class="text-slate-400">Layanan konsultasi WhatsApp siaga 24 jam.</span>
          </p>
        </div>

        <!-- Contact Methods List -->
        <div class="space-y-3">
          
          <!-- WhatsApp Hotline -->
          <a href="https://wa.me/628112899009?text=Halo%20PEMAPI%2C%20saya%20ingin%20konsultasi%20mengenai%20layanan%20APAR" 
             target="_blank" 
             class="glass-card-dark rounded-2xl p-5 border border-white/10 hover:border-emerald-500/40 transition-all card-hover-effect flex items-center gap-4 group">
            <div class="size-12 rounded-2xl bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 flex items-center justify-center text-xl shrink-0 group-hover:scale-110 transition-transform">
              <i class="fa-brands fa-whatsapp"></i>
            </div>
            <div class="flex-grow">
              <p class="text-xs text-slate-400 font-medium">WhatsApp Customer Service</p>
              <p class="text-base font-bold text-white group-hover:text-emerald-400 transition-colors">0811-2899-009</p>
            </div>
            <i class="fa-solid fa-chevron-right text-slate-500 text-xs"></i>
          </a>

          <!-- Telepon Kantor -->
          <a href="tel:08112899009" 
             class="glass-card-dark rounded-2xl p-5 border border-white/10 hover:border-blue-500/40 transition-all card-hover-effect flex items-center gap-4 group">
            <div class="size-12 rounded-2xl bg-blue-500/20 text-blue-400 border border-blue-500/30 flex items-center justify-center text-xl shrink-0 group-hover:scale-110 transition-transform">
              <i class="fa-solid fa-phone"></i>
            </div>
            <div class="flex-grow">
              <p class="text-xs text-slate-400 font-medium">Panggilan Suara / Telepon</p>
              <p class="text-base font-bold text-white group-hover:text-blue-400 transition-colors">0811-2899-009</p>
            </div>
            <i class="fa-solid fa-chevron-right text-slate-500 text-xs"></i>
          </a>

          <!-- Email -->
          <a href="mailto:pemapi.adm@gmail.com" 
             class="glass-card-dark rounded-2xl p-5 border border-white/10 hover:border-red-500/40 transition-all card-hover-effect flex items-center gap-4 group">
            <div class="size-12 rounded-2xl bg-red-500/20 text-red-400 border border-red-500/30 flex items-center justify-center text-xl shrink-0 group-hover:scale-110 transition-transform">
              <i class="fa-regular fa-envelope"></i>
            </div>
            <div class="flex-grow">
              <p class="text-xs text-slate-400 font-medium">Email Penawaran & Administrasi</p>
              <p class="text-sm sm:text-base font-bold text-white group-hover:text-red-400 transition-colors">pemapi.adm@gmail.com</p>
            </div>
            <i class="fa-solid fa-chevron-right text-slate-500 text-xs"></i>
          </a>

          <!-- Alamat -->
          <a href="https://www.google.com/maps/place/APAR-ALAT+PEMADAM+API-PEMAPI+SEMARANG/@-6.9837104,110.3971474,17z" 
             target="_blank" 
             class="glass-card-dark rounded-2xl p-5 border border-white/10 hover:border-amber-500/40 transition-all card-hover-effect flex items-start gap-4 group">
            <div class="size-12 rounded-2xl bg-amber-500/20 text-amber-400 border border-amber-500/30 flex items-center justify-center text-xl shrink-0 group-hover:scale-110 transition-transform mt-0.5">
              <i class="fa-solid fa-location-dot"></i>
            </div>
            <div class="flex-grow">
              <p class="text-xs text-slate-400 font-medium">Kantor & Workshop</p>
              <p class="text-sm font-bold text-white group-hover:text-amber-400 transition-colors leading-snug">
                Jalan Puspanjolo Dalam 5 No. 10, RT 011, RW 001, Semarang, Jawa Tengah 50141
              </p>
              <span class="text-xs text-amber-400 font-semibold inline-flex items-center gap-1 mt-1">
                <span>Buka di Google Maps</span>
                <i class="fa-solid fa-arrow-up-right-from-square text-[10px]"></i>
              </span>
            </div>
          </a>

        </div>

      </div>

      <!-- Right Form (7 Cols) -->
      <div class="lg:col-span-7">
        <div class="glass-card-dark rounded-3xl p-6 sm:p-10 border border-white/10 shadow-2xl relative">
          
          <div class="mb-8 space-y-2">
            <h3 class="text-2xl font-bold text-white">Kirim Pesan Langsung</h3>
            <p class="text-xs text-slate-400">Isi formulir di bawah ini dan konsultan kami akan menghubungi Anda sesegera mungkin.</p>
          </div>

          <!-- Quick Topic Preset Chips -->
          <div class="mb-6 space-y-2">
            <label class="text-xs font-semibold text-slate-300">Pilih Kebutuhan Anda (Opsional):</label>
            <div class="flex flex-wrap gap-2">
              <button type="button" @click="messageTopic = 'Beli APAR Baru'" class="px-3 py-1.5 rounded-xl text-xs font-semibold transition-colors cursor-pointer" :class="messageTopic === 'Beli APAR Baru' ? 'bg-red-600 text-white' : 'bg-white/5 text-slate-300 hover:bg-white/10'">
                Beli APAR Baru
              </button>
              <button type="button" @click="messageTopic = 'Isi Ulang (Refill) APAR'" class="px-3 py-1.5 rounded-xl text-xs font-semibold transition-colors cursor-pointer" :class="messageTopic === 'Isi Ulang (Refill) APAR' ? 'bg-red-600 text-white' : 'bg-white/5 text-slate-300 hover:bg-white/10'">
                Refill / Isi Ulang
              </button>
              <button type="button" @click="messageTopic = 'Survei & Konsultasi Gedung'" class="px-3 py-1.5 rounded-xl text-xs font-semibold transition-colors cursor-pointer" :class="messageTopic === 'Survei & Konsultasi Gedung' ? 'bg-red-600 text-white' : 'bg-white/5 text-slate-300 hover:bg-white/10'">
                Survei Gedung
              </button>
              <button type="button" @click="messageTopic = 'Dukungan Pemapi App'" class="px-3 py-1.5 rounded-xl text-xs font-semibold transition-colors cursor-pointer" :class="messageTopic === 'Dukungan Pemapi App' ? 'bg-red-600 text-white' : 'bg-white/5 text-slate-300 hover:bg-white/10'">
                Bantuan Aplikasi
              </button>
            </div>
          </div>

          <!-- Contact Form -->
          <form @submit="isSubmitting = true" 
                action="/contact-us/submit" 
                method="post" 
                class="space-y-5">
            
            <div class="space-y-1.5">
              <label for="input-nama" class="block text-xs font-bold uppercase tracking-wider text-slate-300">
                Nama Lengkap / Nama Perusahaan <span class="text-red-400">*</span>
              </label>
              <input type="text" 
                     id="input-nama" 
                     name="nama" 
                     placeholder="Contoh: Budi Santoso / PT. Maju Bersama" 
                     required
                     class="w-full px-4 py-3.5 rounded-2xl bg-white/5 border border-white/10 text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-red-500/50 focus:border-red-500 transition-all text-sm">
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
              <div class="space-y-1.5">
                <label for="input-email" class="block text-xs font-bold uppercase tracking-wider text-slate-300">
                  Email Aktif <span class="text-red-400">*</span>
                </label>
                <input type="email" 
                       id="input-email" 
                       name="email" 
                       placeholder="nama@perusahaan.com" 
                       required
                       class="w-full px-4 py-3.5 rounded-2xl bg-white/5 border border-white/10 text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-red-500/50 focus:border-red-500 transition-all text-sm">
              </div>

              <div class="space-y-1.5">
                <label for="input-phone" class="block text-xs font-bold uppercase tracking-wider text-slate-300">
                  Nomor Telepon / WhatsApp <span class="text-red-400">*</span>
                </label>
                <input type="tel" 
                       id="input-phone" 
                       name="phone" 
                       placeholder="Contoh: 081234567890" 
                       required
                       class="w-full px-4 py-3.5 rounded-2xl bg-white/5 border border-white/10 text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-red-500/50 focus:border-red-500 transition-all text-sm">
              </div>
            </div>

            <div class="space-y-1.5">
              <label for="input-pesan" class="block text-xs font-bold uppercase tracking-wider text-slate-300">
                Pesan / Rincian Kebutuhan <span class="text-red-400">*</span>
              </label>
              <textarea id="input-pesan" 
                        name="pesan" 
                        rows="4" 
                        placeholder="Tuliskan jumlah tabung, tipe ruangan, atau pertanyaan Anda..." 
                        required
                        class="w-full px-4 py-3.5 rounded-2xl bg-white/5 border border-white/10 text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-red-500/50 focus:border-red-500 transition-all text-sm resize-none"></textarea>
            </div>

            <button type="submit" 
                    :disabled="isSubmitting"
                    class="w-full py-4 px-6 rounded-2xl font-bold text-white bg-gradient-to-r from-red-600 to-rose-600 hover:from-red-500 hover:to-rose-500 shadow-xl shadow-red-600/30 hover:shadow-red-600/50 transition-all duration-300 transform hover:-translate-y-0.5 active:scale-95 disabled:opacity-50 text-base cursor-pointer flex items-center justify-center gap-2">
              <span x-show="!isSubmitting">Kirim Pesan Sekarang</span>
              <span x-show="isSubmitting" x-cloak class="flex items-center gap-2">
                <i class="fa-solid fa-spinner animate-spin"></i>
                <span>Mengirimkan Pesan...</span>
              </span>
            </button>

          </form>

        </div>
      </div>

    </div>

  </div>
</div>

<!-- ── MODAL ALERT FOR FORM SUBMISSION STATUS ── -->
<% if (typeof alert !== 'undefined' && alert) { %>
<div x-data="{ modalOpen: true }" 
     x-show="modalOpen" 
     x-cloak 
     class="fixed inset-0 z-50 overflow-y-auto" 
     role="dialog" 
     aria-modal="true">
  
  <div class="fixed inset-0 bg-slate-950/80 backdrop-blur-md transition-opacity" @click="modalOpen = false"></div>

  <div class="flex min-h-full items-center justify-center p-4 text-center sm:p-0">
    <div class="relative transform overflow-hidden rounded-3xl bg-slate-900 border border-white/15 text-left shadow-2xl transition-all sm:my-8 w-full sm:max-w-md p-6 sm:p-8 space-y-6">
      
      <div class="text-center space-y-4">
        <% if (alertColor === 'green') { %>
          <div class="size-16 rounded-full bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 flex items-center justify-center text-3xl mx-auto">
            <i class="fa-solid fa-circle-check"></i>
          </div>
          <h3 class="text-2xl font-extrabold text-white">Pesan Berhasil Terkirim!</h3>
          <p class="text-sm text-slate-300 leading-relaxed">
            Terima kasih telah menghubungi PEMAPI. Tim konsultan kami akan segera menghubungi Anda melalui nomor telepon / email yang tertera.
          </p>
        <% } else { %>
          <div class="size-16 rounded-full bg-red-500/20 text-red-400 border border-red-500/30 flex items-center justify-center text-3xl mx-auto">
            <i class="fa-solid fa-triangle-exclamation"></i>
          </div>
          <h3 class="text-2xl font-extrabold text-white">Pengiriman Belum Berhasil</h3>
          <p class="text-sm text-slate-300 leading-relaxed">
            Pastikan seluruh data form (Nama, Nomor Telepon minimal 11 digit, dan Pesan minimal 10 karakter) terisi dengan benar.
          </p>
        <% } %>
      </div>

      <button @click="modalOpen = false" 
              type="button" 
              class="w-full py-3.5 px-6 rounded-2xl font-bold text-white bg-white/10 hover:bg-white/20 border border-white/10 transition-colors text-sm cursor-pointer">
        Tutup
      </button>

    </div>
  </div>
</div>
<% } %>