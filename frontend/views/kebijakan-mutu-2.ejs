<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

<%- include('seo-head') %>
<%- include('analytics') %>

    <!-- Tailwind CSS -->
    <link rel="stylesheet" type="text/css" href="/css/final.css">

    <!-- Alpine.js -->
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>

    <style>
        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: Inter, ui-sans-serif, system-ui, sans-serif;
        }

        .text-balance {
            text-wrap: balance;
        }

        .policy-number {
            background: linear-gradient(
                135deg,
                #0E3477,
                #17458F
            );
        }

        .hero-grid {
            background-image:
                linear-gradient(
                    rgba(14, 52, 119, 0.045) 1px,
                    transparent 1px
                ),
                linear-gradient(
                    90deg,
                    rgba(14, 52, 119, 0.045) 1px,
                    transparent 1px
                );
            background-size: 42px 42px;
        }

        .glass {
            background: rgba(255, 255, 255, 0.82);
            backdrop-filter: blur(12px);
        }

        @media print {
            .no-print {
                display: none !important;
            }

            body {
                background: white !important;
            }

            .print-shadow {
                box-shadow: none !important;
            }
        }
    </style>
</head>

<body class="bg-slate-50 text-slate-800">

<div
    x-data="{ menuOpen: false }"
    class="min-h-screen"
>

    <!-- =====================================================
         NAVBAR
    ====================================================== -->

    <header class="sticky top-0 z-50 border-b border-slate-200 bg-white/95 backdrop-blur">
        <div class="mx-auto flex h-20 max-w-7xl items-center justify-between px-6 lg:px-8">

            <!-- Brand -->
            <a href="/" class="flex items-center gap-3">

                <!-- Logo Placeholder -->
                <div
                    class="flex h-11 w-11 items-center justify-center rounded-xl bg-brand text-white shadow-lg shadow-brand/20"
                >
                    <span class="text-lg font-black tracking-tight">
                        P
                    </span>
                </div>

                <div>
                    <div class="text-sm font-black tracking-wide text-brand">
                        PEMAPI
                    </div>

                    <div class="text-[10px] font-medium uppercase tracking-[0.18em] text-slate-500">
                        PT Coco Profire Indonesia
                    </div>
                </div>

            </a>


            <!-- Desktop Navigation -->

            <nav class="hidden items-center gap-8 md:flex">

                <a
                    href="/"
                    class="text-sm font-medium text-slate-600 transition hover:text-brand"
                >
                    Home
                </a>
                <a
                    href="#visi"
                    class="text-sm font-medium text-slate-600 transition hover:text-brand"
                >
                    Visi
                </a>

                <a
                    href="#misi"
                    class="text-sm font-medium text-slate-600 transition hover:text-brand"
                >
                    Misi
                </a>

                <a
                    href="#kebijakan"
                    class="text-sm font-medium text-slate-600 transition hover:text-brand"
                >
                    Kebijakan Mutu
                </a>

                <a
                    href="#pengesahan"
                    class="rounded-lg bg-brand px-4 py-2.5 text-sm font-semibold text-white shadow-md shadow-brand/20 transition hover:bg-brand-dark"
                >
                    Pengesahan
                </a>

            </nav>


            <!-- Mobile Button -->

            <button
                @click="menuOpen = !menuOpen"
                class="rounded-lg p-2 text-slate-600 hover:bg-slate-100 md:hidden"
                aria-label="Menu"
            >
                <svg
                    x-show="!menuOpen"
                    class="h-6 w-6"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M4 6h16M4 12h16M4 18h16"
                    />
                </svg>

                <svg
                    x-show="menuOpen"
                    class="h-6 w-6"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M6 18L18 6M6 6l12 12"
                    />
                </svg>
            </button>

        </div>


        <!-- Mobile Navigation -->

        <div
            x-show="menuOpen"
            x-transition
            class="border-t border-slate-200 bg-white px-6 py-4 md:hidden"
        >
            <div class="flex flex-col gap-1">

                <a
                    href="#visi"
                    @click="menuOpen = false"
                    class="rounded-lg px-3 py-3 text-sm font-medium hover:bg-brand-light"
                >
                    Visi
                </a>

                <a
                    href="#misi"
                    @click="menuOpen = false"
                    class="rounded-lg px-3 py-3 text-sm font-medium hover:bg-brand-light"
                >
                    Misi
                </a>

                <a
                    href="#kebijakan"
                    @click="menuOpen = false"
                    class="rounded-lg px-3 py-3 text-sm font-medium hover:bg-brand-light"
                >
                    Kebijakan Mutu
                </a>

            </div>
        </div>

    </header>


    <!-- =====================================================
         HERO
    ====================================================== -->

    <main>

        <section class="relative overflow-hidden bg-white">

            <!-- Grid -->
            <div class="hero-grid absolute inset-0"></div>

            <!-- Decorative Circle -->
            <div
                class="absolute -right-32 -top-32 h-96 w-96 rounded-full bg-brand/5"
            ></div>

            <div
                class="absolute -left-40 bottom-0 h-80 w-80 rounded-full bg-brand/5"
            ></div>


            <div
                class="relative mx-auto max-w-7xl px-6 py-20 lg:px-8 lg:py-28"
            >

                <div class="max-w-4xl">

                    <!-- Eyebrow -->

                    <div class="mb-7 inline-flex items-center gap-3 rounded-full border border-brand/15 bg-brand-light px-4 py-2">

                        <span class="h-2 w-2 rounded-full bg-brand"></span>

                        <span
                            class="text-xs font-bold uppercase tracking-[0.18em] text-brand"
                        >
                            Sistem Manajemen Mutu
                        </span>

                    </div>


                    <!-- Heading -->

                    <h1
                        class="max-w-4xl text-balance text-4xl font-black tracking-tight text-brand sm:text-5xl lg:text-6xl"
                    >
                        Kebijakan Mutu
                    </h1>


                    <p
                        class="mt-6 max-w-2xl text-lg leading-8 text-slate-600"
                    >
                        Komitmen PT COCO PROFIRE INDONESIA dalam memberikan
                        kualitas terbaik, meningkatkan kepuasan pelanggan,
                        serta melakukan perbaikan berkelanjutan.
                    </p>


                    <!-- Document Meta -->

                    <div class="mt-10 flex flex-wrap gap-3">

                        <div class="rounded-xl border border-slate-200 bg-white px-4 py-3 shadow-sm">

                            <div class="text-[10px] font-bold uppercase tracking-widest text-slate-400">
                                Dokumen
                            </div>

                            <div class="mt-1 text-sm font-bold text-brand">
                                SMM-CPI-L-01
                            </div>

                        </div>


                        <div class="rounded-xl border border-slate-200 bg-white px-4 py-3 shadow-sm">

                            <div class="text-[10px] font-bold uppercase tracking-widest text-slate-400">
                                Ditetapkan
                            </div>

                            <div class="mt-1 text-sm font-bold text-brand">
                                1 September 2025
                            </div>

                        </div>


                        <div class="rounded-xl border border-slate-200 bg-white px-4 py-3 shadow-sm">

                            <div class="text-[10px] font-bold uppercase tracking-widest text-slate-400">
                                Lokasi
                            </div>

                            <div class="mt-1 text-sm font-bold text-brand">
                                Semarang
                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </section>


        <!-- =====================================================
             COMPANY INTRO
        ====================================================== -->

        <section class="bg-brand">

            <div
                class="mx-auto max-w-7xl px-6 py-14 lg:px-8"
            >

                <div class="grid gap-10 lg:grid-cols-12 lg:items-center">

                    <div class="lg:col-span-4">

                        <span class="text-xs font-bold uppercase tracking-[0.2em] text-white/60">
                            Tentang Kami
                        </span>

                        <h2 class="mt-3 text-2xl font-bold text-white sm:text-3xl">
                            Solusi keselamatan
                            <span class="text-white/70">
                                yang terintegrasi.
                            </span>
                        </h2>

                    </div>


                    <div class="lg:col-span-8">

                        <p class="text-base leading-8 text-white/80 sm:text-lg">
                            PT COCO PROFIRE INDONESIA adalah perusahaan
                            penyedia dan instalasi alat pemadam api dengan
                            merek PEMAPI sekaligus pengembang sistem dan
                            aplikasi PEMAPI.
                        </p>

                    </div>

                </div>

            </div>

        </section>


        <!-- =====================================================
             VISI & MISI
        ====================================================== -->

        <section class="bg-slate-50">

            <div
                class="mx-auto max-w-7xl px-6 py-20 lg:px-8"
            >

                <div class="grid gap-8 lg:grid-cols-2">


                    <!-- VISI -->

                    <article
                        id="visi"
                        class="group rounded-3xl border border-slate-200 bg-white p-8 shadow-sm transition duration-300 hover:-translate-y-1 hover:shadow-xl sm:p-10"
                    >

                        <div class="flex items-start justify-between">

                            <div
                                class="flex h-14 w-14 items-center justify-center rounded-2xl bg-brand-light text-brand"
                            >
                                <svg
                                    class="h-7 w-7"
                                    fill="none"
                                    stroke="currentColor"
                                    viewBox="0 0 24 24"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="1.8"
                                        d="M2.5 12s3.5-7 9.5-7 9.5 7 9.5 7-3.5 7-9.5 7-9.5-7-9.5-7Z"
                                    />

                                    <circle
                                        cx="12"
                                        cy="12"
                                        r="3"
                                        stroke-width="1.8"
                                    />
                                </svg>
                            </div>


                            <span class="text-xs font-black tracking-widest text-slate-300">
                                01
                            </span>

                        </div>


                        <div class="mt-8">

                            <p class="text-xs font-bold uppercase tracking-[0.2em] text-brand">
                                Visi
                            </p>

                            <h2 class="mt-4 text-2xl font-bold leading-tight text-slate-900 sm:text-3xl">
                                Menjadi perusahaan Alat Pemadam dengan kepekaan dan solusi terbaik bagi masyarakat secara luas.
                            </h2>

                        </div>

                    </article>


                    <!-- MISI -->

                    <article
                        id="misi"
                        class="group rounded-3xl border border-slate-200 bg-white p-8 shadow-sm transition duration-300 hover:-translate-y-1 hover:shadow-xl sm:p-10"
                    >

                        <div class="flex items-start justify-between">

                            <div
                                class="flex h-14 w-14 items-center justify-center rounded-2xl bg-brand-light text-brand"
                            >
                                <svg
                                    class="h-7 w-7"
                                    fill="none"
                                    stroke="currentColor"
                                    viewBox="0 0 24 24"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="1.8"
                                        d="M12 3v18M5 8l7-5 7 5M5 16l7 5 7-5"
                                    />
                                </svg>
                            </div>


                            <span class="text-xs font-black tracking-widest text-slate-300">
                                02
                            </span>

                        </div>


                        <div class="mt-8">

                            <p class="text-xs font-bold uppercase tracking-[0.2em] text-brand">
                                Misi
                            </p>


                            <div class="mt-6 space-y-5">

                                <!-- Inovasi -->

                                <div class="flex gap-4">

                                    <div class="mt-1 h-2 w-2 shrink-0 rounded-full bg-brand"></div>

                                    <div>
                                        <h3 class="font-bold text-slate-900">
                                            INOVASI
                                        </h3>

                                        <p class="mt-1 text-sm leading-6 text-slate-600">
                                            Layanan dan teknologi terkini guna mempercepat penyampaian informasi ke semua pihak terkait.
                                        </p>
                                    </div>

                                </div>


                                <!-- Edukasi -->

                                <div class="flex gap-4">

                                    <div class="mt-1 h-2 w-2 shrink-0 rounded-full bg-brand"></div>

                                    <div>
                                        <h3 class="font-bold text-slate-900">
                                            EDUKASI
                                        </h3>

                                        <p class="mt-1 text-sm leading-6 text-slate-600">
                                            Turut berperan meningkatkan wawasan dan implementasi penggunaan Alat Pemadam Api dalam keselamatan kerja.
                                        </p>
                                    </div>

                                </div>


                                <!-- Integrasi -->

                                <div class="flex gap-4">

                                    <div class="mt-1 h-2 w-2 shrink-0 rounded-full bg-brand"></div>

                                    <div>
                                        <h3 class="font-bold text-slate-900">
                                            INTEGRASI
                                        </h3>

                                        <p class="mt-1 text-sm leading-6 text-slate-600">
                                            Monitoring kelayakan APAR melalui integrasi sistem dari hulu ke hilir, untuk peningkatan keamanan data dan implementasi maintenance yang tepat waktu dan sasaran.
                                        </p>
                                    </div>

                                </div>

                            </div>

                        </div>

                    </article>

                </div>

            </div>

        </section>


        <!-- =====================================================
             QUALITY POLICY
        ====================================================== -->

        <section
            id="kebijakan"
            class="bg-white"
        >

            <div
                class="mx-auto max-w-7xl px-6 py-20 lg:px-8"
            >

                <!-- Section Header -->

                <div class="max-w-3xl">

                    <span class="text-xs font-bold uppercase tracking-[0.2em] text-brand">
                        Komitmen Kami
                    </span>

                    <h2 class="mt-3 text-3xl font-black tracking-tight text-slate-900 sm:text-4xl">
                        Komitmen Kebijakan Mutu
                    </h2>

                    <p class="mt-4 text-base leading-7 text-slate-600">
                        Dalam menjalankan kegiatan bisnisnya, PT COCO PROFIRE
                        INDONESIA menyusun dan menetapkan kebijakan mutu
                        dengan komitmen untuk:
                    </p>

                </div>


                <!-- Policy Grid -->

                <div
                    class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3"
                >


                    <!-- 01 -->

                    <article
                        class="group relative overflow-hidden rounded-2xl border border-slate-200 bg-white p-7 shadow-sm transition duration-300 hover:-translate-y-1 hover:border-brand/20 hover:shadow-xl"
                    >

                        <div class="policy-number flex h-11 w-11 items-center justify-center rounded-xl text-sm font-black text-white shadow-lg shadow-brand/20">
                            01
                        </div>

                        <h3 class="mt-6 text-lg font-bold text-slate-900">
                            Mencegah Keluhan Pelanggan
                        </h3>

                        <p class="mt-3 text-sm leading-6 text-slate-600">
                            Mencegah adanya keluhan dari pelanggan dengan
                            melakukan investasi terhadap sumber daya manusia
                            dan teknologi yang terbaik.
                        </p>

                    </article>


                    <!-- 02 -->

                    <article
                        class="group relative overflow-hidden rounded-2xl border border-slate-200 bg-white p-7 shadow-sm transition duration-300 hover:-translate-y-1 hover:border-brand/20 hover:shadow-xl"
                    >

                        <div class="policy-number flex h-11 w-11 items-center justify-center rounded-xl text-sm font-black text-white shadow-lg shadow-brand/20">
                            02
                        </div>

                        <h3 class="mt-6 text-lg font-bold text-slate-900">
                            Kepuasan Pelanggan
                        </h3>

                        <p class="mt-3 text-sm leading-6 text-slate-600">
                            Memastikan dan mengedepankan kepuasan pelanggan
                            serta terus melakukan perbaikan pelayanan secara
                            berkesinambungan.
                        </p>

                    </article>


                    <!-- 03 -->

                    <article
                        class="group relative overflow-hidden rounded-2xl border border-slate-200 bg-white p-7 shadow-sm transition duration-300 hover:-translate-y-1 hover:border-brand/20 hover:shadow-xl"
                    >

                        <div class="policy-number flex h-11 w-11 items-center justify-center rounded-xl text-sm font-black text-white shadow-lg shadow-brand/20">
                            03
                        </div>

                        <h3 class="mt-6 text-lg font-bold text-slate-900">
                            Kepatuhan & Keselamatan
                        </h3>

                        <p class="mt-3 text-sm leading-6 text-slate-600">
                            Patuh terhadap peraturan perundang-undangan,
                            persyaratan K3 termasuk CSMS, lingkungan hidup,
                            kualitas terbaik, harga kompetitif, serta jadwal
                            penyelesaian tepat waktu.
                        </p>

                    </article>


                    <!-- 04 -->

                    <article
                        class="group relative overflow-hidden rounded-2xl border border-slate-200 bg-white p-7 shadow-sm transition duration-300 hover:-translate-y-1 hover:border-brand/20 hover:shadow-xl"
                    >

                        <div class="policy-number flex h-11 w-11 items-center justify-center rounded-xl text-sm font-black text-white shadow-lg shadow-brand/20">
                            04
                        </div>

                        <h3 class="mt-6 text-lg font-bold text-slate-900">
                            Pelatihan Terencana
                        </h3>

                        <p class="mt-3 text-sm leading-6 text-slate-600">
                            Pelatihan yang terencana untuk meningkatkan
                            kompetensi karyawan.
                        </p>

                    </article>


                    <!-- 05 -->

                    <article
                        class="group relative overflow-hidden rounded-2xl border border-slate-200 bg-white p-7 shadow-sm transition duration-300 hover:-translate-y-1 hover:border-brand/20 hover:shadow-xl"
                    >

                        <div class="policy-number flex h-11 w-11 items-center justify-center rounded-xl text-sm font-black text-white shadow-lg shadow-brand/20">
                            05
                        </div>

                        <h3 class="mt-6 text-lg font-bold text-slate-900">
                            Perbaikan Berkelanjutan
                        </h3>

                        <p class="mt-3 text-sm leading-6 text-slate-600">
                            Melakukan perbaikan kinerja Mutu, Kesehatan &
                            Keselamatan Kerja dan Lingkungan secara terus
                            menerus.
                        </p>

                    </article>


                    <!-- 06 -->

                    <article
                        class="group relative overflow-hidden rounded-2xl border border-slate-200 bg-white p-7 shadow-sm transition duration-300 hover:-translate-y-1 hover:border-brand/20 hover:shadow-xl"
                    >

                        <div class="policy-number flex h-11 w-11 items-center justify-center rounded-xl text-sm font-black text-white shadow-lg shadow-brand/20">
                            06
                        </div>

                        <h3 class="mt-6 text-lg font-bold text-slate-900">
                            Kerjasama & Kemitraan
                        </h3>

                        <p class="mt-3 text-sm leading-6 text-slate-600">
                            Menjalin kerjasama yang baik dengan pemegang saham,
                            pegawai, masyarakat, pemerintah serta mitra kerja.
                        </p>

                    </article>

                </div>

            </div>

        </section>


        <!-- =====================================================
             CLOSING / APPROVAL
        ====================================================== -->

        <section
            id="pengesahan"
            class="bg-brand"
        >

            <div
                class="mx-auto max-w-7xl px-6 py-20 lg:px-8"
            >

                <div class="grid gap-12 lg:grid-cols-12 lg:items-center">


                    <!-- Left -->

                    <div class="lg:col-span-7">

                        <span class="text-xs font-bold uppercase tracking-[0.2em] text-white/50">
                            Pernyataan Komitmen
                        </span>

                        <h2 class="mt-4 max-w-2xl text-3xl font-black tracking-tight text-white sm:text-4xl">
                            Mutu adalah komitmen yang kami jalankan secara berkelanjutan.
                        </h2>

                        <p class="mt-5 max-w-2xl leading-7 text-white/70">
                            Kebijakan ini menjadi landasan bagi seluruh
                            kegiatan PT COCO PROFIRE INDONESIA dalam memberikan
                            pelayanan dan solusi terbaik kepada pelanggan
                            serta seluruh pemangku kepentingan.
                        </p>

                    </div>


                    <!-- Approval Card -->

                    <div class="lg:col-span-5">

                        <div class="glass rounded-3xl p-7 shadow-2xl sm:p-9">

                            <div class="flex items-center justify-between">

                                <div>

                                    <div class="text-[10px] font-bold uppercase tracking-[0.18em] text-slate-400">
                                        Ditetapkan oleh
                                    </div>

                                    <div class="mt-2 text-lg font-black text-brand">
                                        Direktur
                                    </div>

                                </div>


                                <div
                                    class="flex h-12 w-12 items-center justify-center rounded-xl bg-brand-light text-brand"
                                >

                                    <svg
                                        class="h-6 w-6"
                                        fill="none"
                                        stroke="currentColor"
                                        viewBox="0 0 24 24"
                                    >
                                        <path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            stroke-width="1.8"
                                            d="M9 12l2 2 4-4M20 7l-8-4-8 4v5c0 5 3.4 8.4 8 10 4.6-1.6 8-5 8-10V7Z"
                                        />
                                    </svg>

                                </div>

                            </div>


                            <!-- Signature -->

                            <div class="my-8 h-px bg-slate-200"></div>


                            <div class="text-center">

                                <!-- Signature placeholder -->

                                <div class="mx-auto mb-5 h-12 flex items-center justify-center">

                                    <span class="font-serif text-2xl italic text-brand/60">
                                        Apriliawan Setiya Ramadhany
                                    </span>

                                </div>


                                <h3 class="text-xl font-black text-slate-900">
                                    Apriliawan Setiya Ramadhany
                                </h3>

                                <p class="mt-1 text-sm font-medium text-slate-500">
                                    Direktur
                                </p>

                                <div class="mt-5 inline-flex rounded-full bg-brand-light px-4 py-2">

                                    <span class="text-xs font-bold text-brand">
                                        Semarang · 1 September 2025
                                    </span>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </section>

    </main>


    <!-- =====================================================
         FOOTER
    ====================================================== -->

    <footer class="bg-brand-dark">

        <div
            class="mx-auto max-w-7xl px-6 py-8 lg:px-8"
        >

            <div class="flex flex-col gap-5 sm:flex-row sm:items-center sm:justify-between">

                <div>

                    <div class="text-sm font-black tracking-wide text-white">
                        PT COCO PROFIRE INDONESIA
                    </div>

                    <div class="mt-1 text-xs text-white/40">
                        PEMAPI — Solusi keselamatan dan proteksi kebakaran
                    </div>

                </div>


                <div class="text-xs text-white/40">
                    SMM-CPI-L-01
                </div>

            </div>

        </div>

    </footer>


    <!-- =====================================================
         BACK TO TOP
    ====================================================== -->

    <button
        x-data="{ show: false }"
        x-init="window.addEventListener('scroll', () => show = window.scrollY > 500)"
        x-show="show"
        x-transition
        @click="window.scrollTo({ top: 0, behavior: 'smooth' })"
        class="no-print fixed bottom-6 right-6 flex h-12 w-12 items-center justify-center rounded-full bg-brand text-white shadow-xl shadow-brand/30 transition hover:bg-brand-dark"
        aria-label="Kembali ke atas"
    >

        <svg
            class="h-5 w-5"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
        >
            <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M5 15l7-7 7 7"
            />
        </svg>

    </button>

